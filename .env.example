# Jev API key (TypeSafe: https://api.typesafe.ai ; free host keys start with jv_live_)
JEV_API_KEY=

# Optional. Default is the TypeSafe endpoint. For the free host use:
# JEV_BASE_URL=https://jev-agent.com/api/v1/systemone
JEV_BASE_URL=

# Optional. jev-latest | jev-preview | jev-1.13.0
JEV_MODEL=jev-latest

# Claude agents for the research example (or use `ant auth login`). Optional model override.
ANTHROPIC_API_KEY=
CLAUDE_AGENT_MODEL=
